{
  "name": "chaika-mobile-app",
  "version": "1.1.397",
  "description": "Chaika Life - справочник мест Чайки + заявки соседей",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "metro:free-port": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File scripts/free-metro-port.ps1",
    "start": "npm run metro:free-port && expo start --port 8088 --offline --max-workers 1",
    "android": "expo run:android",
    "start:android": "npm run metro:free-port && expo start --android --port 8088 --offline --max-workers 1",
    "ios": "expo run:ios",
    "web": "expo start --web --offline --max-workers 1",
    "eject": "expo eject",
    "test": "jest",
    "test:rules:emulator": "node scripts/run-rules-emulator-tests.mjs",
    "moderation": "node scripts/moderation-cli.mjs",
    "seed:gallery": "node scripts/seed-gallery-to-firebase.mjs",
    "firebase:preflight": "node scripts/firebase-preflight.mjs",
    "upload:test-photo": "node scripts/upload-test-photo.mjs",
    "test:help-photo": "node scripts/test-help-neighbors-photo-client.mjs",
    "daemon": "node agents/ai-diagnostics/daemon.mjs",
    "audit:community-photos": "node scripts/audit-community-photos.mjs",
    "backfill:community-photos-public": "node scripts/backfill-community-photos-public.mjs",
    "type-check": "tsc --noEmit",
    "check:encoding": "node scripts/check-encoding.js",
    "rules:check": "node -e \"JSON.parse(require('fs').readFileSync('firebase.rules.json','utf8')); console.log('firebase.rules.json ok')\"",
    "rules:check:storage": "node -e \"const fs=require('fs'); const rules=fs.readFileSync('storage.rules','utf8'); if(!rules.includes('service firebase.storage')){throw new Error('storage.rules invalid')} console.log('storage.rules ok')\"",
    "migrate:dating-privacy": "node scripts/migrate-dating-privacy.mjs",
    "migrate:media-privacy": "node scripts/migrate-media-download-urls.mjs",
    "migrate:places-names": "node scripts/migrate-places-names.mjs",
    "verify:places-names": "node scripts/verify-places-names.mjs",
    "deploy:rules": "firebase deploy --only database,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build --prefix admin-panel && firebase deploy --only hosting",
    "deploy:prod": "npm run build --prefix admin-panel && firebase deploy --only database,storage,functions,hosting",
    "deploy:prod:checked": "npm run type-check && npm run rules:check && npx jest firebaseRulesSecurity --runInBand && npm run deploy:prod",
    "ship": "node scripts/ship.mjs",
    "ship:full": "node scripts/ship.mjs --deploy --push",
    "build:apk": "eas build --platform android --profile preview --local",
    "build:apk:cloud": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "postinstall": "node scripts/patch-expo-modules-agp8.js && node scripts/patch-cli-status-page.js",
    "facebook:keyhash:debug": "node scripts/get-facebook-keyhash.js",
    "facebook:keyhash:eas": "eas credentials --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-firebase/app": "^18.9.0",
    "@react-native-firebase/crashlytics": "^18.9.0",
    "@react-native-firebase/messaging": "^18.9.0",
    "@react-native-google-signin/google-signin": "^10.1.2",
    "@react-native-picker/picker": "2.6.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^1.9.7",
    "expo": "^50.0.0",
    "expo-apple-authentication": "~6.3.0",
    "expo-application": "~5.8.4",
    "expo-auth-session": "~5.4.0",
    "expo-av": "~13.10.5",
    "expo-clipboard": "~5.0.1",
    "expo-crypto": "~12.8.1",
    "expo-file-system": "~16.0.9",
    "expo-font": "~11.10.3",
    "expo-image-manipulator": "~11.8.0",
    "expo-image-picker": "~14.7.1",
    "expo-intent-launcher": "~10.11.0",
    "expo-linking": "~6.2.2",
    "expo-location": "~16.5.5",
    "expo-notifications": "~0.27.7",
    "expo-secure-store": "~12.8.1",
    "expo-system-ui": "~2.9.4",
    "expo-web-browser": "~12.8.2",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-fbsdk-next": "^12.2.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-maps": "1.10.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-shadow-2": "^7.1.2",
    "react-native-svg": "14.1.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.19.6",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.45",
    "dotenv": "^16.3.2",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.1.1"
  },
  "private": true
}
