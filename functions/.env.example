# ===== AI MODERATION CONFIGURATION =====
#
# Get API key from provider:
# - OpenCode Zen (FREE): https://opencode.ai/auth
# - DeepSeek: https://platform.deepseek.com
# - OpenAI: https://platform.openai.com
# - Claude/Anthropic: https://console.anthropic.com
#
# Set AI_PROVIDER to one of: opencode (default), deepseek, openai, claude

# === OpenCode Zen (FREE models) ===
AI_PROVIDER=opencode
AI_API_KEY=your-opencode-api-key
AI_MODEL=deepseek-v4-flash-free
AI_BASE_URL=https://opencode.ai/zen/v1
# Free models: deepseek-v4-flash-free, mimo-v2.5-free, minimax-m3-free, nemotron-3-super-free

# === DeepSeek ===
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-chat

# === OpenAI ===
# AI_PROVIDER=openai
# AI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=gpt-4o-mini

# === Claude ===
# AI_PROVIDER=claude
# AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=claude-haiku-4-5-20251001

# Budget limits (requests per day/month)
AI_BUDGET_DAILY=5000
AI_BUDGET_MONTHLY=100000

# Firebase API (required for email/password sign-in via Cloud Functions)
# Get this from your Firebase project settings → General tab → Web API Key
FIREBASE_API_KEY=your-firebase-api-key

# Telegram (existing)
TELEGRAM_BOT_TOKEN=your-telegram-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
TELEGRAM_CHANNEL_ID=your-telegram-channel-id-here
CHAYKA_TELEGRAM_TOPIC=your-telegram-topic-here
