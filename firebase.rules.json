{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "requests": {
      ".read": "auth != null",
      ".indexOn": ["status", "category", "userId", "timestamp"],
      "$requestId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('role').val() === 'moderator')"
      }
    },

    "community_photos": {
      ".read": "auth != null",
      ".indexOn": "status",
