    "security_logs": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).child('role').val() === 'admin' || root.child('user_roles').child(auth.uid).child('role').val() === 'moderator')",
      ".write": "auth != null"
    },

    "_security": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('user_roles').child(auth.uid).child('role').val() === 'admin'"
    },

    "chaika_news": {
      ".read": true,
      ".write": "auth != null && root.child('user_roles').child(auth.uid).child('role').val() === 'admin'"
    },

    "app_version": {
      ".read": true,
      ".write": "auth != null && root.child('user_roles').child(auth.uid).child('role').val() === 'admin'"
    },

    "problem_votes": {
