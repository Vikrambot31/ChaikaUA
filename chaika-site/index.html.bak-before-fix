<script>
    const versionInfo = document.getElementById('version-info');
    const downloadApk = document.getElementById('download-apk');
    const siteSplash = document.getElementById('site-splash');
    const siteSplashVideo = document.getElementById('site-splash-video');
    const promoVideo = document.getElementById('promo-video');
    const promoVideoSection = document.getElementById('promo-video-section');
    const instructionBtn = document.getElementById('open-instruction-video');
    const instructionVideoWrap = document.getElementById('instruction-video-wrap');
    const instructionVideo = document.getElementById('instruction-video');
    const sliderTrack = document.getElementById('install-slider-track');
    const sliderDotsWrap = document.getElementById('install-slider-dots');
    const sliderPrev = document.getElementById('slide-prev');
    const sliderNext = document.getElementById('slide-next');

    document.body.classList.add('splash-lock');

    const hideSiteSplash = () => {
        if (siteSplash) {
            siteSplash.style.display = 'none';
            document.body.classList.remove('splash-lock');
        }
    };

    if (siteSplash && siteSplashVideo) {
        let splashStarted = false;

        siteSplashVideo.addEventListener('playing', () => {
            splashStarted = true;
        });

        siteSplashVideo.addEventListener('timeupdate', () => {
            if (siteSplashVideo.currentTime > 0) {
                splashStarted = true;
            }
        });

        siteSplashVideo.addEventListener('ended', hideSiteSplash);
        siteSplashVideo.addEventListener('error', hideSiteSplash);
        siteSplashVideo.play().catch(hideSiteSplash);
        setTimeout(() => {
            if (!splashStarted) hideSiteSplash();
        }, 2500);
        setTimeout(hideSiteSplash, 12000);
    } else {
        document.body.classList.remove('splash-lock');
    }

    fetch('release/latest.json', { cache: 'no-store' })
        .then((response) => {
            if (!response.ok) throw new Error('latest.json unavailable');
            return response.json();
        })
        .then((release) => {
            if (release.version) {
                const formattedDate = release.buildDate
                    ? release.buildDate.split('-').reverse().join('.')
                    : '21.05.2026';
                versionInfo.innerHTML = `РћСЃС‚Р°РЅРЅСЏ РІРµСЂСЃС–СЏ ${release.version}<small>РћРЅРѕРІР»РµРЅРѕ ${formattedDate} В· Android В· Р‘РµР·РєРѕС€С‚РѕРІРЅРѕ</small>`;
            }
            if (release.apkUrl) {
                downloadApk.href = release.apkUrl;
            }
        })
        .catch(() => {
            downloadApk.href = 'release/app-release.apk';
        });

    new QRCode(document.getElementById('qr-code'), {
        text: 'https://chaika-life.netlify.app/',
        width: 180,
        height: 180,
        colorDark: '#2D2016',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H
    });

    if (promoVideo && promoVideoSection) {
        promoVideo.addEventListener('ended', () => {
            promoVideoSection.style.display = 'none';
        });

        promoVideo.addEventListener('error', () => {
            promoVideoSection.style.display = 'none';
        });

        promoVideo.play().catch(() => {
            promoVideoSection.style.display = 'none';
        });
    }

    if (instructionBtn && instructionVideoWrap && instructionVideo) {
        instructionBtn.addEventListener('click', () => {
            const isShown = instructionVideoWrap.classList.contains('show');
            if (isShown) {
                instructionVideoWrap.classList.remove('show');
                instructionBtn.textContent = 'РЎРјРѕС‚СЂРµС‚СЊ Р†РЅСЃС‚СЂСѓРєС†С–СЋ РІС–РґРµРѕ';
                instructionVideo.pause();
                return;
            }

            instructionVideoWrap.classList.add('show');
            instructionBtn.textContent = 'РЎС…РѕРІР°С‚Рё РІС–РґРµРѕ С–РЅСЃС‚СЂСѓРєС†С–СЋ';
            instructionVideo.play().catch(() => {});
        });
    }

    if (sliderTrack && sliderDotsWrap && sliderPrev && sliderNext) {
        const slides = Array.from(sliderTrack.children);
        let currentSlide = 0;
        let touchStartX = 0;
        let touchEndX = 0;

        const dots = slides.map((_, index) => {
            const dot = document.createElement('button');
            dot.className = 'slider-dot';
            dot.type = 'button';
            dot.setAttribute('aria-label', 'Слайд ' + (index + 1));
            dot.addEventListener('click', () => goToSlide(index));
            sliderDotsWrap.appendChild(dot);
            return dot;
        });

        const updateSlider = () => {
            sliderTrack.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
            dots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentSlide);
            });
        };

        const goToSlide = (index) => {
            if (index < 0) currentSlide = slides.length - 1;
            else if (index >= slides.length) currentSlide = 0;
            else currentSlide = index;
            updateSlider();
        };

        sliderPrev.addEventListener('click', () => goToSlide(currentSlide - 1));
        sliderNext.addEventListener('click', () => goToSlide(currentSlide + 1));

        sliderTrack.addEventListener('touchstart', (event) => {
            touchStartX = event.changedTouches[0].screenX;
        }, { passive: true });

        sliderTrack.addEventListener('touchend', (event) => {
            touchEndX = event.changedTouches[0].screenX;
            const delta = touchEndX - touchStartX;
            if (Math.abs(delta) < 35) return;
            if (delta > 0) goToSlide(currentSlide - 1);
            else goToSlide(currentSlide + 1);
        }, { passive: true });

        updateSlider();
    }
</script>

