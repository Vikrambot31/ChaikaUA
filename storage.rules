rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Группа E: Storage (Этап 1, шаги 1.3 Дни 9-10) ──────────────────────
    // profile_photos/{uid}/... — читает любой auth, пишет только владелец
    match /profile_photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // community_photos/{uid}/... — путь содержит uid загрузчика (см. photoUploadService)
    // Читает любой auth. Пишет только владелец (загрузчик) или admin через CF.
    match /community_photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // uploads/users/{uid}/... — личная очередь загрузок, только владелец
    match /uploads/users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // dating_profiles/{uid}/... — личные фото анкет, только владелец
    match /dating_profiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // dating_anketa_listings/{uid}/... — то же для анкет
    match /dating_anketa_listings/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Остальные пути (lost_found, buy_sell, contacts, local_business и др.)
    // Читает любой auth. Пишет любой auth — модерация на уровне CF и RTDB rules.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
